#!name = 贴吧去广告
#!desc = 拦截百度贴吧广告：信息流 native 广告卡(推荐/热门/最新) + 广告素材/三方 SDK/统计（不改动 App 正常请求）
#!author = Loon 社区
#!system = iOS, iPadOS
#!loon_version = 3.5.1(978)
#!date = 2026-10-28
#!tag = 去广告,贴吧,工具
#!type = normal

# =====================================================================
# 一、纯广告 / 埋点 / 三方广告 SDK：REJECT 域名（格式：匹配类型,域名,策略）
#   抓包确认这些 host 只承载广告/统计，App 不依赖，拦截安全。
#   想保留百度游戏，删掉 gamedelivery 那行。
# =====================================================================
[Rule]
DOMAIN-SUFFIX,gsp0.baidu.com,REJECT
DOMAIN-SUFFIX,sofire.baidu.com,REJECT
DOMAIN-SUFFIX,sofire.bdstatic.com,REJECT
DOMAIN-SUFFIX,tcbox.baidu.com,REJECT
DOMAIN-SUFFIX,h2tcbox.baidu.com,REJECT
DOMAIN-SUFFIX,gamedelivery.cdn.bcebos.com,REJECT
DOMAIN-SUFFIX,union-httpdns.gslb.yy.com,REJECT
DOMAIN-SUFFIX,dmpstatic.cdn.bcebos.com,REJECT
DOMAIN-SUFFIX,miaowu.baidu.com,REJECT
DOMAIN-SUFFIX,ada.baidu.com,REJECT
DOMAIN-SUFFIX,nsclick.baidu.com,REJECT
DOMAIN-SUFFIX,mlog.bigda.com,REJECT

# =====================================================================
# 二、Script：信息流 native 广告卡（"天天有保/京东/快手"等）protobuf 手术
#   覆盖 推荐(excellent/personalized) / 热门(frs/page) / 最新(pb/page、firstPage)
#   JS 托管在本仓库同目录（harmonizr/okInterface/tieba-adblock/tieba_feed_ad.js），
#   Loon 导入本 .lpx 后会自动拉取并缓存，无需本地导入 JS。
#   若脚本任务里看不到执行（国内访问 GitHub raw 不稳定），把这行 script(...) 里的
#   地址换成 jsDelivr 镜像再试：
#   "https://cdn.jsdelivr.net/gh/harmonizr/okInterface@master/tieba-adblock/tieba_feed_ad.js"
# =====================================================================
[Script]
response if ${url} ~= /tiebac\.baidu\.com\/c\/(f\/excellent\/personalized|f\/frs\/page|f\/pb\/(page|firstPage))/i && ${response.status} == 200 then script("https://github.com/harmonizr/okInterface/raw/master/tieba-adblock/tieba_feed_ad.js") with requires_body=true, binary_body_mode=true, tag="贴吧信息流去广告"
