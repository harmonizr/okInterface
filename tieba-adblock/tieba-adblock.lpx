#!name = 贴吧去广告
#!desc = 拦截百度贴吧全部广告：信息流/推荐流 native 广告 / 帖内 / 评论区 / 贴纸开屏素材 / 三方广告 SDK 与统计
#!author = Loon 社区
#!system = iOS, iPadOS
#!loon_version = 3.5.1(978)
#!date = 2026-10-28
#!tag = 去广告,贴吧,工具
#!type = normal

# =====================================================================
# 一、纯广告 / 统计 / 三方广告 SDK：REJECT 域名（无需 MitM，最稳）
#       想保留百度游戏，删掉 gamedelivery 那行。
# =====================================================================
[Rule]
DOMAIN-SUFFIX,gsp0.baidu.com,REJECT
DOMAIN-SUFFIX,sofire.baidu.com,REJECT
DOMAIN-SUFFIX,sofire.bdstatic.com,REJECT
DOMAIN-SUFFIX,tcbox.baidu.com,REJECT
DOMAIN-SUFFIX,h2tcbox.baidu.com,REJECT
DOMAIN-SUFFIX,gamedelivery.cdn.bcebos.com,REJECT
DOMAIN-SUFFIX,union-httpdns.gslb.yy.com,REJECT
DOMAIN-SUFFIX,dmpstatic.cdn.bcebos.com,REJECT
DOMAIN-SUFFIX,miaowu.baidu.com,REJECT
DOMAIN-SUFFIX,ada.baidu.com,REJECT
DOMAIN-SUFFIX,nsclick.baidu.com,REJECT
DOMAIN-SUFFIX,mlog.bigda.com,REJECT

# =====================================================================
# 二、MitM：仅对需要改 JSON 的 HTTPS 接口（material/home 评论区广告）
#       getFeedAd / excellent/personalized 都是 http，不需要 MitM
# =====================================================================
[Mitm]
hostname = tieba.baidu.com

# =====================================================================
# 三、Rewrite：内容主机上的广告专用接口 + 首页/评论区 JSON 清洗
# =====================================================================
[Rewrite]
# 信息流广告 / 广告竞价 / 广告曝光日志 → 命中回 200 空体，不请求上游
request if ${url} ~= /baidu\.com\/c\/(f|b|s)\/ad\/(getFeedAd|adBid|adLog|adNewLog)/i then reject(200)
# 首页/评论区：material/home 把 comment_area_ads、is_tiebaplus_ad 归零
response if ${url} ~= /tieba\.baidu\.com\/c\/f\/material\/home/ && ${response.status} == 200 then response.json.jq(`walk(if type=="object" then (if has("comment_area_ads") then .comment_area_ads=0 else . end) | (if has("is_tiebaplus_ad") then .is_tiebaplus_ad="0" else . end) else . end)`)

# =====================================================================
# 四、Script：推荐流 native 广告（"天天有保"等）protobuf 手术
#       [Script] 引用独立 JS（本仓库 tieba-adblock/tieba_feed_ad.js），走 jsDelivr 加速（国内更稳）。
#       Loon 会自动拉取并缓存该 JS。若 jsDelivr 失效，可换回 GitHub raw：
#       https://raw.githubusercontent.com/harmonizr/okInterface/master/tieba-adblock/tieba_feed_ad.js
# =====================================================================
[Script]
response if ${url} ~= /tiebac\.baidu\.com\/c\/f\/excellent\/personalized/i && ${response.status} == 200 then script("https://cdn.jsdelivr.net/gh/harmonizr/okInterface@master/tieba-adblock/tieba_feed_ad.js") with requires_body=true, binary_body_mode=true, tag="贴吧推荐流去广告"
