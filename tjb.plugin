#!name=定时POST请求
#!desc=面板自定义参数，定时发送请求

[Argument]
interval=input,"5",tag=执行间隔(分钟),desc=多久发送一次请求
url=input,"https://xxx.com",tag=请求地址,desc=要提交的网址
body=input,"{\"msg\":\"自定义数据\"}",tag=POST发送内容,desc=发送的JSON内容

# 下面这整行就是【Script脚本】，Loon里定时脚本就这么写，不用[Script]标签
cron "* * * * *" script=!async()=>{
const interval=Number($argument.interval)||5;
const url=$argument.url;
const body=$argument.body||"";
let last=+$persistentStore.read("lastRun")||0,now=Date.now();
if(now-last<interval*60*1000)return;
$persistentStore.write(now,"lastRun");
$httpClient.request({url:url,method:"POST",headers:{"Content-Type":"application/json"},body:body},e=>console.log(e?"失败":"成功"));
},argument=*,enable=true