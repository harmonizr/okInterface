#!name=自定义间隔定时脚本
#!desc=面板设置几分钟执行一次

[Argument]
# 这里就是你截图里的输入框，直接在Loon控制面板修改
intervalMin=input,"5",tag=执行间隔(分钟),desc=你想要几分钟执行一次
requestUrl=input,"https://xxx.com",tag=请求地址,desc=目标接口
postBody=input,"{\"msg\":\"测试\"}",tag=POST内容,desc=发送的数据

[Script]
cron "* * * * *" script-path=https://gist.githubusercontent.com/Alex0510/8b958bcf53ed1271e03bb5130b2206ec/raw/kugou_vip.js, tag=酷狗领取VIP