#!name=淘金币助力
#!desc=面板设置几分钟执行一次和助力链接

[Argument]
interval=input,"*/3 * * * *",tag=执行间隔(分钟),desc=你想要几分钟执行一次
times=input,"2",tag=重置账号次数
name=input,tag=昵称

tjbUrl=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据
tjbUrl2=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据
tjbUrl3=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据
tjbUrl4=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据
tjbUrl5=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据
tjbUrl6=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据


[Script]
cron {interval} script-path=https://raw.giteeusercontent.com/user_hzr/okinterface/raw/master/jdjAdd.js,timeout = 300,tag=淘金币,argument=[{tjbUrl},{tjbUrl2},{tjbUrl3},{tjbUrl4},{tjbUrl5},{tjbUrl6},{helpId},{times},{name}]