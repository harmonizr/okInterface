#!name=淘金币助力
#!desc=面板设置几分钟执行一次和助力链接

[Argument]
interval=input,"*/3 * * * *",tag=执行间隔(分钟),desc=你想要几分钟执行一次
helpId=input,"{\"msg\":\"测试\"}",tag=助力链接,desc=发送的数据
tjbUrl=input,"{\"msg\":\"测试\"}",tag=淘金币链接,desc=发送的数据

[Script]
cron {interval} script-path=https://raw.giteeusercontent.com/user_hzr/okinterface/raw/master/tjb.js,timeout = 300,tag=淘金币,argument=[{tjbUrl},{helpId}]