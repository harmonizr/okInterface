#!name = 哈啰净化 (Loon 版)
#!author = TG@ZenMoFiShi · Loon 移植
#!update = 2026-10-25
#!desc = 净化弹窗、首页推荐流、借钱入口与会员领券横条，隐藏我的页推广宫格、推荐、奖励金、接单券提醒及钱包金融整排。运行时自动拉取上游 easybike-ad.js 并缓存 6 小时。

[Rule]
# —— 广告 SDK 直拦: 返回 HTTP 200 空响应 ——
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) url reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) url reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) url reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) url reject-200

[Script]
