#!name = 哈啰净化 (Loon 版)
#!author = TG@ZenMoFiShi · Loon 移植
#!update = 2026-10-25
#!desc = 净化弹窗、首页推荐流、借钱入口与会员领券横条，隐藏我的页推广宫格、推荐、奖励金、接单券提醒及钱包金融整排。脚本: harmonizr/okInterface 仓库 hellobike-loon/hbe-bridge-oneline.js (运行时自动拉取上游 easybike-ad.js 并缓存 6 小时)。

[Rule]
# —— 广告 SDK 直拦: 返回 HTTP 200 空响应 ——
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) url reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) url reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) url reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) url reject-200

[Script]
# —— 净化脚本 (统一引用仓库内桥接脚本; raw.githubusercontent.com 需可达) ——
^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$ url script-response "https://raw.githubusercontent.com/harmonizr/okInterface/master/hellobike-loon/hbe-bridge-oneline.js", tag="HelloBikeCapital", requires-body=1
^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$) url script-response-body "https://raw.githubusercontent.com/harmonizr/okInterface/master/hellobike-loon/hbe-bridge-oneline.js", tag="HelloBikeKey", requires-body=1
^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) url script-request-body "https://raw.githubusercontent.com/harmonizr/okInterface/master/hellobike-loon/hbe-bridge-oneline.js", tag="HelloBikeReq", requires-body=1
^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) url script-response-body "https://raw.githubusercontent.com/harmonizr/okInterface/master/hellobike-loon/hbe-bridge-oneline.js", tag="HelloBikeResp", requires-body=1

# 原 QX 片的 hostname = 行无 Loon 对应项: 哈啰 App 流量走代理且开 MITM 即可。
