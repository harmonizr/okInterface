#!name = 网易云
#!desc = 网易云音乐 最高音质
#!author = WeiGiegie
#!openUrl = 
#!homepage = https://gitee.com/user_hzr/okinterface/raw/master/wyy.plugin
#!icon = https://github.com/Moli-X/Resources/raw/main/Icon/Other/Fdds.png
#!date = 2025-06-09

# 原链接:https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js


[Rewrite]
# 去除部分广告
^https?:\/\/(?:ipv4|interface\d?)\.music\.163\.com\/e?api\/(mine\/(collect|rn)\/header\/info|v\d\/user\/detail\/\d+|vipnewcenter\/app\/resource\/newaccountpage|music-vip-membership\/(client|front)\/vip\/info|batch|playlist\/privilege|search\/complex\/page|v\d\/(discovery\/recommend\/songs|playlist\/detail)) header-replace x-aeapi false
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/vip\/cashier\/tspopup\/get - reject-200

[Script]

http-request ^https:\/\/interface3?\.music\.163\.com\/eapi\/playermode\/ script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云播放器会员皮肤

http-request ^https:\/\/interface3?\.music\.163\.com\/eapi\/search\/complex\/(page|rec\/song\/get) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云搜索结果会员歌曲

http-request ^https:\/\/interface3?\.music\.163\.com\/eapi\/v3\/song\/detail script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云歌曲详情
http-request ^https:\/\/interface3?\.music\.163\.com\/eapi\/song\/(chorus|enhance\/|play\/|type\/detail\/get) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云特殊播放功能
http-request ^https:\/\/interface3?\.music\.163\.com\/eapi\/(v1\/artist\/top\/song|v3\/discovery\/recommend\/songs) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云推荐歌曲

http-request ^https:\/\/interface3?\.music\.163\.com\/eapi\/vipnewcenter\/app\/resource\/newaccountpage script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云会员等级

http-request ^https?:\/\/interface3?\.music\.163\.com\/eapi\/(homepage\/|v6\/)?playlist\/ script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云首页歌单

http-request ^https?:\/\/interface3?\.music\.163\.com\/eapi\/vipauth\/app\/auth\/(soundquality\/)?query script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/wangyiyun.js, timeout=10, tag=网易云会员认证

[MITM] 
hostname = *music.163.com
