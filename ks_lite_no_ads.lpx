# ============================================================
# Kuaishou Lite (kpn=NEBULA) - Remove video ad flow
# Loon config snippet (merge into the [MITM] / [Script] / [Rule] sections of the main config)
# Verified in 2026-11-22 HAR
#   - Series (short drama / course) feed ads: rest/nebula/tube/standard/serial/episode/scroll
#   - Splash ad: rest/nebula/ad/splashAd
#   - Ad resource warmup / ad model / ad tracking: REJECT
# Requires the script ks_lite_ad.js to be placed in Loon's scripts directory
# ============================================================

[MITM]
hostname = az2-api.ksapisrv.com

[Script]
# Series feed (ad insertion / IAA timer / commercial banner) + splash ad
response if ${url} ~= /rest\/nebula\/(ad\/splashAd|tube\/standard\/serial\/episode\/scroll)/ then script("https://raw.githubusercontent.com/harmonizr/okInterface/refs/heads/master/ks_lite_ad.js") with tag="KS-Lite Ad-Remove", requires_body=true, timeout=30

[Rule]
# Ad component warmup download
^https?://ad-resource-warmup\.kwd\.inkuai\.com/ reject
# Ad series exit prediction model (EVE)
^https?://[a-z0-9-]*wsukwai\.com/kos/.*Task_Ad.* reject
# Ad impression / click tracking
^https?://az2-api\.ksapisrv\.com/rest/nebula/log/ad/trackLog.* reject
# Third-party ad network statistics (Tencent / Anjuke)
^https?://qbugreport\.html5\.qq\.com/ybstat.* reject
^https?://api\.anjuke\.com/anjuke/market/ad/.* reject